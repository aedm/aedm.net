---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSlugFromId } from '../../utils/blog';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-title {
				margin-bottom: 0.5rem;
			}
			
			.page-description {
				color: var(--text-muted);
				margin-bottom: 3rem;
			}
			
			.posts-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			
			.post-card {
				display: block;
				padding: 1.5rem;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			
			.post-card:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-glow);
				transform: translateY(-2px);
			}
			
			.post-title {
				font-size: 1.25rem;
				font-weight: 600;
				color: var(--text-primary);
				margin: 0 0 0.5rem 0;
				line-height: 1.4;
			}
			
			.post-card:hover .post-title {
				color: var(--accent-light);
			}
			
			.post-description {
				color: var(--text-secondary);
				font-size: 0.95rem;
				margin: 0 0 0.75rem 0;
				line-height: 1.6;
			}
			
			.post-meta {
				display: flex;
				gap: 1rem;
				color: var(--text-muted);
				font-size: 0.85rem;
			}
			
			.post-date {
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}
			
			@media (max-width: 640px) {
				.post-card {
					padding: 1.25rem;
				}
				
				.post-title {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Blog</h1>
			<p class="page-description">Thoughts on software engineering, Rust, and other adventures.</p>
			
			<div class="posts-list">
				{posts.map((post) => {
					const slug = post.data.slug || getSlugFromId(post.id);
					return (
						<a href={`/blog/${slug}/`} class="post-card">
							<h2 class="post-title">{post.data.title}</h2>
							<p class="post-description">{post.data.description}</p>
							<div class="post-meta">
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</div>
						</a>
					);
				})}
			</div>
		</main>
		<Footer />
	</body>
</html>
