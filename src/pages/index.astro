---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, AUTHOR_NAME } from '../consts';
import { getSlugFromId } from '../utils/blog';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5); // Show latest 5 posts
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 3rem 0 4rem;
				text-align: center;
			}
			
			.greeting {
				font-size: 1rem;
				color: var(--accent-light);
				font-weight: 500;
				margin-bottom: 0.75rem;
				font-family: var(--font-mono);
			}
			
			.hero-title {
				font-size: 3rem;
				font-weight: 700;
				margin: 0 0 1.5rem 0;
				letter-spacing: -0.03em;
				line-height: 1.1;
			}
			
			.hero-title .gradient {
				background: var(--gradient-accent);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			
			.hero-description {
				font-size: 1.15rem;
				color: var(--text-secondary);
				max-width: 540px;
				margin: 0 auto 2rem;
				line-height: 1.7;
			}
			
			.cta-links {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			
			.cta-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.75rem 1.5rem;
				border-radius: 8px;
				font-weight: 500;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			
			.cta-primary {
				background: var(--accent);
				color: white;
			}
			
			.cta-primary:hover {
				background: var(--accent-light);
				box-shadow: var(--shadow-glow);
			}
			
			.cta-secondary {
				background: var(--bg-tertiary);
				color: var(--text-primary);
				border: 1px solid var(--border);
			}
			
			.cta-secondary:hover {
				border-color: var(--accent);
				color: var(--accent-light);
			}
			
			.section {
				margin-top: 4rem;
			}
			
			.section-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.5rem;
			}
			
			.section-title {
				font-size: 1.5rem;
				font-weight: 600;
				margin: 0;
			}
			
			.section-link {
				font-size: 0.9rem;
				color: var(--accent-light);
			}
			
			.posts-list {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			
			.post-item {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				padding: 1rem 1.25rem;
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 10px;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			
			.post-item:hover {
				border-color: var(--accent);
				transform: translateX(4px);
			}
			
			.post-date {
				color: var(--text-muted);
				font-size: 0.85rem;
				font-family: var(--font-mono);
				flex-shrink: 0;
				width: 100px;
			}
			
			.post-title {
				color: var(--text-primary);
				font-weight: 500;
				flex: 1;
			}
			
			.post-item:hover .post-title {
				color: var(--accent-light);
			}
			
			@media (max-width: 640px) {
				.hero {
					padding: 2rem 0 3rem;
				}
				
				.hero-title {
					font-size: 2.25rem;
				}
				
				.hero-description {
					font-size: 1rem;
				}
				
				.post-item {
					flex-direction: column;
					gap: 0.25rem;
					padding: 1rem;
				}
				
				.post-date {
					width: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="greeting">Hi, I'm {AUTHOR_NAME}</p>
				<h1 class="hero-title">
					Software engineer<br/>
					<span class="gradient">& code craftsman</span>
				</h1>
				<p class="hero-description">
					Welcome to my corner of the web. I write about software engineering, 
					Rust, graphics programming, and whatever else catches my interest.
				</p>
				<div class="cta-links">
					<a href="/blog" class="cta-link cta-primary">Read the blog</a>
					<a href="/about" class="cta-link cta-secondary">About me</a>
				</div>
			</section>
			
			<section class="section">
				<header class="section-header">
					<h2 class="section-title">Latest Posts</h2>
					<a href="/blog" class="section-link">View all →</a>
				</header>
				<div class="posts-list">
					{posts.map((post) => {
						const slug = post.data.slug || getSlugFromId(post.id);
						return (
							<a href={`/blog/${slug}/`} class="post-item">
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="post-title">{post.data.title}</span>
							</a>
						);
					})}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
